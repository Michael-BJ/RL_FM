<?xml version="1.0" ?>
<!--
  box_narrow.sdf — dibuat oleh generate_wide_worlds.py
  Eksperimen ambiguitas multimodal: obstacle lebar di sumbu terbang y=0.
  Koordinat IDENTIK dengan box_narrow.pcd (peta ground-truth expert).

  Pakai:
    cp box_narrow.sdf ~/PX4-Autopilot/Tools/simulation/gz/worlds/
    ros2 launch neo_planner sitl.launch.py world:=box_narrow
-->
<sdf version="1.9">
  <world name="box_narrow">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- WAJIB untuk magnetometer PX4 SITL -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397742</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>488.0</elevation>
    </spherical_coordinates>

    <plugin filename="gz-sim-physics-system"            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"  name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"      name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system"                name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system"       name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-altimeter-system"          name="gz::sim::systems::Altimeter"/>
    <plugin filename="gz-sim-magnetometer-system"       name="gz::sim::systems::Magnetometer"/>
    <!-- WAJIB: tanpa NavSat -> "Compass Sensor 0 missing" -->
    <plugin filename="gz-sim-navsat-system"             name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-contact-system"            name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_1">
      <pose>6.00 0.00 1.800 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.60 1.30 3.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.60 1.30 3.60</size></box></geometry>
          <material>
            <ambient>0.7 0.2 0.2 1</ambient>
            <diffuse>0.8 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_2">
      <pose>14.00 0.00 1.800 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.60 1.60 3.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.60 1.60 3.60</size></box></geometry>
          <material>
            <ambient>0.7 0.2 0.2 1</ambient>
            <diffuse>0.8 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
