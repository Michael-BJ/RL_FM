<?xml version="1.0" ?>
<!--
  poles.sdf  (Gazebo modern / gz sim, untuk PX4 SITL ROS2)
  ========================================================
  Setara dengan poles.world dari NEO-Planner paper (Gazebo Classic).
  13 obstacle (4 silinder + 9 box) di koordinat IDENTIK dgn poles.pcd.

  Cara pakai:
    1. Copy file ini ke directory worlds PX4-Autopilot:
         cp poles.sdf ~/PX4-Autopilot/Tools/simulation/gz/worlds/

    2. Jalankan SITL dengan world=poles:
         ros2 launch neo_planner sitl.launch.py world:=poles

  Catatan:
    - Untuk konsistensi VISUAL (depth camera) dengan ESDF (dari poles.pcd),
      drone yang spawn HARUS lihat obstacle yang SAMA dengan yang ada di .pcd.
    - SDF di sini dibangun dari pose obstacle di poles.world asli.
    - Drone akan spawn di (0, 0, 0) by default (PX4 SITL behavior).
    - Plugin <plugin filename="gz-sim-..."/> sesuai struktur world Gazebo
      modern (ogre2 rendering, sensors system, dll).
-->
<sdf version="1.9">
  <world name="poles">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- WAJIB untuk magnetometer PX4 SITL — tanpa ini: "Compass Sensor 0 missing" -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397742</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>488.0</elevation>
    </spherical_coordinates>

    <plugin filename="gz-sim-physics-system"            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"  name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"      name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system"                name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system"       name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-altimeter-system"          name="gz::sim::systems::Altimeter"/>
    <plugin filename="gz-sim-magnetometer-system"       name="gz::sim::systems::Magnetometer"/>
    <!-- WAJIB: tanpa NavSat, navsat_sensor di drone tidak aktif → GPS tidak ada
         → sensor_mag_sim PX4 tidak bisa hitung medan magnet → "Compass Sensor 0 missing" -->
    <plugin filename="gz-sim-navsat-system"             name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-contact-system"            name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         4 CYLINDERS (radius=0.5m, length=3.9m, center z=1.95)
         Posisi sama persis dgn poles.world asli + poles.pcd
         ═══════════════════════════════════════════════════════════════════ -->

    <model name="pole_1">
      <pose>6.80 -2.61 1.95 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>3.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>3.9</length></cylinder></geometry>
          <material>
            <ambient>0.6 0.3 0.1 1</ambient>
            <diffuse>0.7 0.4 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pole_2">
      <pose>12.16 3.05 1.95 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>3.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>3.9</length></cylinder></geometry>
          <material>
            <ambient>0.6 0.3 0.1 1</ambient>
            <diffuse>0.7 0.4 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pole_3">
      <pose>15.26 -3.25 1.95 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>3.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>3.9</length></cylinder></geometry>
          <material>
            <ambient>0.6 0.3 0.1 1</ambient>
            <diffuse>0.7 0.4 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pole_4">
      <pose>20.82 0.02 1.95 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>3.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>3.9</length></cylinder></geometry>
          <material>
            <ambient>0.6 0.3 0.1 1</ambient>
            <diffuse>0.7 0.4 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         3 SMALL BOXES (size 1×1×3.36, center z=1.68)
         ═══════════════════════════════════════════════════════════════════ -->

    <model name="box_small_1">
      <pose>3.58 -0.17 1.68 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 3.36</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 3.36</size></box></geometry>
          <material>
            <ambient>0.4 0.5 0.7 1</ambient>
            <diffuse>0.5 0.6 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_small_2">
      <pose>10.99 -3.74 1.68 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 3.36</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 3.36</size></box></geometry>
          <material>
            <ambient>0.4 0.5 0.7 1</ambient>
            <diffuse>0.5 0.6 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_small_3">
      <pose>17.82 2.90 1.68 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 3.36</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 3.36</size></box></geometry>
          <material>
            <ambient>0.4 0.5 0.7 1</ambient>
            <diffuse>0.5 0.6 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         6 LARGE BOXES (size 1×1×6.26, center z=3.13)
         ═══════════════════════════════════════════════════════════════════ -->

    <model name="box_large_1">
      <pose>5.51 2.46 3.13 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 6.26</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 6.26</size></box></geometry>
          <material>
            <ambient>0.7 0.2 0.2 1</ambient>
            <diffuse>0.8 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_large_2">
      <pose>3.00 -4.00 3.13 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 6.26</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 6.26</size></box></geometry>
          <material>
            <ambient>0.7 0.2 0.2 1</ambient>
            <diffuse>0.8 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_large_3">
      <pose>22.30 3.09 3.13 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 6.26</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 6.26</size></box></geometry>
          <material>
            <ambient>0.7 0.2 0.2 1</ambient>
            <diffuse>0.8 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_large_4">
      <pose>9.66 0.20 3.13 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 6.26</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 6.26</size></box></geometry>
          <material>
            <ambient>0.7 0.2 0.2 1</ambient>
            <diffuse>0.8 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_large_5">
      <pose>14.00 0.00 3.13 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 6.26</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 6.26</size></box></geometry>
          <material>
            <ambient>0.7 0.2 0.2 1</ambient>
            <diffuse>0.8 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_large_6">
      <pose>19.29 -4.68 3.13 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 6.26</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 6.26</size></box></geometry>
          <material>
            <ambient>0.7 0.2 0.2 1</ambient>
            <diffuse>0.8 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
